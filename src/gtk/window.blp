using Gtk 4.0;
using Adw 1;

template $AubadeWindow: Adw.ApplicationWindow {
  handle-menubar-accel: true;
  width-request: 360;
  height-request: 660;
  default-width: 1200;
  default-height: 820;

  content: WindowHandle {
    $DragOverlay drag_overlay {
      title: _("Drop a song to add it to the playlist");

      child: Adw.ToastOverlay toast_overlay {
        child: Stack main_stack {
          transition-type: crossfade;

          StackPage {
            name: "initial-view";

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                show-title: false;
              }

              content: Adw.Clamp {
                maximum-size: 450;
                vexpand: true;
                valign: fill;

                child: Adw.StatusPage status_page {
                  margin-start: 12;
                  margin-end: 12;
                  title: "Aubade";
                  description: _("Select a file or a folder, or drag files from your file manager to the application window to add songs to the playlist");

                  child: Box {
                    orientation: vertical;
                    halign: center;
                    homogeneous: true;
                    spacing: 12;

                    Button restore_playlist_button {
                      label: _("Restore Playlist");
                      action-name: "queue.restore-playlist";

                      styles [
                        "suggested-action",
                        "pill",
                      ]
                    }

                    Button add_folder_button {
                      label: _("Add Folder");
                      action-name: "queue.add-folder";

                      styles [
                        "pill",
                      ]
                    }

                    Button {
                      label: _("Add Song");
                      action-name: "queue.add-song";

                      styles [
                        "pill",
                      ]
                    }
                  };
                };
              };
            };
          }

          StackPage {
            name: "main-view";

            child: Box {
              orientation: horizontal;

              Box octave_sidebar {
                orientation: vertical;
                width-request: 256;
                hexpand: false;
                spacing: 4;

                styles [
                  "octave-sidebar",
                ]

                Box {
                  spacing: 10;
                  margin-start: 16;
                  margin-end: 16;
                  margin-top: 18;
                  margin-bottom: 12;

                  Label {
                    label: "Aubade";
                    xalign: 0;
                    hexpand: true;

                    styles [
                      "octave-wordmark",
                    ]
                  }
                }

                Button {
                  action-name: "win.show-home";

                  styles [
                    "flat",
                    "octave-nav-row",
                  ]

                  child: Box {
                    spacing: 14;

                    Image {
                      icon-name: "go-home-symbolic";
                    }

                    Label {
                      label: _("Home");
                      xalign: 0;
                      hexpand: true;
                    }
                  };
                }

                Button {
                  action-name: "win.leave-home";

                  styles [
                    "flat",
                    "octave-nav-row",
                  ]

                  child: Box {
                    spacing: 14;

                    Image {
                      icon-name: "view-queue-symbolic";
                    }

                    Label {
                      label: _("Now Playing");
                      xalign: 0;
                      hexpand: true;
                    }
                  };
                }

                Separator {
                  margin-start: 16;
                  margin-end: 16;
                  margin-top: 12;
                  margin-bottom: 12;
                }

                Label {
                  label: _("LIBRARY");
                  xalign: 0;
                  margin-start: 20;
                  margin-bottom: 4;

                  styles [
                    "octave-section-label",
                  ]
                }

                Label sidebar_stats {
                  xalign: 0;
                  margin-start: 20;
                  margin-end: 16;
                  wrap: true;
                  vexpand: true;
                  valign: start;

                  styles [
                    "octave-meta",
                  ]
                }

                Label {
                  label: "Aubade";
                  margin-bottom: 16;

                  styles [
                    "octave-credit",
                  ]
                }
              }

              Box split_view {
                orientation: vertical;
                hexpand: true;
                vexpand: true;

                Box {
                  orientation: horizontal;
                  height-request: 56;
                  spacing: 4;
                  margin-start: 12;
                  margin-end: 12;

                  styles [
                    "octave-topbar",
                  ]

                  Button {
                    icon-name: "go-previous-symbolic";
                    action-name: "win.leave-home";
                    tooltip-text: _("Back");

                    styles [
                      "flat",
                      "octave-icon-button",
                    ]
                  }

                  Button {
                    icon-name: "go-next-symbolic";
                    action-name: "win.show-home";
                    tooltip-text: _("Forward");

                    styles [
                      "flat",
                      "octave-icon-button",
                    ]
                  }

                  Box {
                    hexpand: true;
                  }
                }

                ScrolledWindow {
                  hscrollbar-policy: never;
                  vscrollbar-policy: automatic;
                  hexpand: true;
                  vexpand: true;

                  child: Stack content_stack {
                    transition-type: crossfade;

                    StackPage {
                      name: "home";

                      child: $AubadeOctaveHome octave_home {};
                    }

                    StackPage {
                      name: "queue";

                      child: $AubadePlaylistView playlist_view {};
                    }
                  };
                }

                Box {
                  orientation: horizontal;
                  height-request: 90;
                  spacing: 18;
                  margin-start: 16;
                  margin-end: 16;
                  margin-top: 10;
                  margin-bottom: 10;

                  styles [
                    "octave-player-bar",
                  ]

                  Box {
                    orientation: horizontal;
                    valign: center;
                    width-request: 270;
                    spacing: 10;

                    Stack cover_stack {
                      valign: center;
                      width-request: 56;
                      height-request: 56;
                      transition-type: crossfade;

                      StackPage {
                        name: "cover";

                        child: $AubadeSongCover song_cover {};
                      }

                      StackPage {
                        name: "lyrics";

                        child: $AubadeLyricsView lyrics_view {
                          width-request: 56;
                          height-request: 56;
                        };
                      }
                    }

                    $AubadeSongDetails song_details {
                      hexpand: true;
                      valign: center;
                    }
                  }

                  Box {
                    orientation: vertical;
                    valign: center;
                    hexpand: true;
                    spacing: 2;

                    $AubadePlaybackControl playback_control {
                      hexpand: true;
                      valign: center;
                    }

                    Box {
                      orientation: horizontal;
                      spacing: 8;

                      Label elapsed_label {
                        label: "0:00";

                        accessibility {
                          label: C_("a11y", "Elapsed time");
                        }

                        styles [
                          "caption",
                          "numeric",
                        ]
                      }

                      $AubadeWaveformView waveform_view {
                        can-focus: "true";
                        hexpand: true;
                      }

                      Label remaining_label {
                        label: "0:00";

                        accessibility {
                          label: C_("a11y", "Remaining time");
                        }

                        styles [
                          "caption",
                          "numeric",
                        ]
                      }
                    }
                  }

                  Box {
                    orientation: horizontal;
                    valign: center;
                    spacing: 4;

                    ToggleButton lyrics_button {
                      icon-name: "lyrics-symbolic";
                      tooltip-text: _("Show Lyrics");
                      action-name: "lyrics.toggle";
                      visible: false;

                      styles [
                        "flat",
                        "octave-icon-button",
                      ]

                      accessibility {
                        label: C_("a11y", "Show lyrics");
                      }
                    }

                    Button fullscreen_button {
                      icon-name: "fullscreen-symbolic";
                      tooltip-text: _("Full Screen");
                      action-name: "win.fullscreen";

                      styles [
                        "flat",
                        "octave-icon-button",
                      ]

                      accessibility {
                        label: C_("a11y", "Full screen");
                      }
                    }
                  }
                }
              }
            };
          }

          StackPage {
            name: "fullscreen";

            child: $AubadeFullScreenView fullscreen_view {};
          }

        };
      };
    }
  };

}
