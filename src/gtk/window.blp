using Gtk 4.0;
using Adw 1;

template $AubadeWindow: Adw.ApplicationWindow {
  handle-menubar-accel: true;
  width-request: 360;
  height-request: 660;
  default-width: 1200;
  default-height: 820;

  content: WindowHandle {
    $DragOverlay drag_overlay {
      title: _("Drop a song to add it to the playlist");

      child: Adw.ToastOverlay toast_overlay {
        child: Stack main_stack {
          transition-type: crossfade;

          StackPage {
            name: "initial-view";

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                show-title: false;
              }

              content: Adw.Clamp {
                maximum-size: 450;
                vexpand: true;
                valign: fill;

                child: Adw.StatusPage status_page {
                  margin-start: 12;
                  margin-end: 12;
                  title: "Aubade";
                  description: _("Select a file or a folder, or drag files from your file manager to the application window to add songs to the playlist");

                  child: Box {
                    orientation: vertical;
                    halign: center;
                    homogeneous: true;
                    spacing: 12;

                    Button restore_playlist_button {
                      label: _("Restore Playlist");
                      action-name: "queue.restore-playlist";

                      styles [
                        "suggested-action",
                        "pill",
                      ]
                    }

                    Button add_folder_button {
                      label: _("Add Folder");
                      action-name: "queue.add-folder";

                      styles [
                        "pill",
                      ]
                    }

                    Button {
                      label: _("Add Song");
                      action-name: "queue.add-song";

                      styles [
                        "pill",
                      ]
                    }
                  };
                };
              };
            };
          }

          StackPage {
            name: "main-view";

            child: Box {
              orientation: horizontal;

              Box octave_sidebar {
                orientation: vertical;
                width-request: 256;
                spacing: 4;

                styles [
                  "octave-sidebar",
                ]

                Box {
                  spacing: 10;
                  margin-start: 16;
                  margin-end: 16;
                  margin-top: 18;
                  margin-bottom: 12;

                  Label {
                    label: "Aubade";
                    xalign: 0;
                    hexpand: true;

                    styles [
                      "octave-wordmark",
                    ]
                  }
                }

                Button {
                  action-name: "win.show-home";

                  styles [
                    "flat",
                    "octave-nav-row",
                  ]

                  child: Box {
                    spacing: 14;

                    Image {
                      icon-name: "go-home-symbolic";
                    }

                    Label {
                      label: _("Home");
                      xalign: 0;
                      hexpand: true;
                    }
                  };
                }

                Button {
                  action-name: "win.leave-home";

                  styles [
                    "flat",
                    "octave-nav-row",
                  ]

                  child: Box {
                    spacing: 14;

                    Image {
                      icon-name: "view-queue-symbolic";
                    }

                    Label {
                      label: _("Now Playing");
                      xalign: 0;
                      hexpand: true;
                    }
                  };
                }

                Separator {
                  margin-start: 16;
                  margin-end: 16;
                  margin-top: 12;
                  margin-bottom: 12;
                }

                Label {
                  label: _("LIBRARY");
                  xalign: 0;
                  margin-start: 20;
                  margin-bottom: 4;

                  styles [
                    "octave-section-label",
                  ]
                }

                Label sidebar_stats {
                  xalign: 0;
                  margin-start: 20;
                  margin-end: 16;
                  wrap: true;
                  vexpand: true;
                  valign: start;

                  styles [
                    "octave-meta",
                  ]
                }

                Label {
                  label: "Aubade";
                  margin-bottom: 16;

                  styles [
                    "octave-credit",
                  ]
                }
              }

              Adw.OverlaySplitView split_view {
                hexpand: true;
                max-sidebar-width: 330;
                sidebar-width-fraction: 0.4;

                content: Adw.ToolbarView {
                  [top]
                  Adw.HeaderBar {
                  show-title: false;

                  [end]
                  Button fullscreen_button {
                    icon-name: "fullscreen-symbolic";
                    tooltip-text: _("Full Screen");
                    action-name: "win.fullscreen";
                    valign: center;

                    accessibility {
                      label: C_("a11y", "Full screen");
                    }
                  }

                  [start]
                  Button home_button {
                    icon-name: "view-queue-symbolic";
                    tooltip-text: _("Library");
                    action-name: "win.show-home";
                    valign: center;
                  }

                  [end]
                  ToggleButton lyrics_button {
                    icon-name: "lyrics-symbolic";
                    tooltip-text: _("Show Lyrics");
                    action-name: "lyrics.toggle";
                    valign: center;
                    visible: false;

                    accessibility {
                      label: C_("a11y", "Show lyrics");
                    }
                  }
                  }

                  content: Box main_box {
                  orientation: vertical;
                  valign: center;
                  vexpand: true;
                  spacing: 6;

                  styles [
                    "main-box",
                  ]

                  Stack cover_stack {
                    transition-type: crossfade;

                    StackPage {
                      name: "cover";

                      child: $AubadeSongCover song_cover {};
                    }

                    StackPage {
                      name: "lyrics";

                      child: $AubadeLyricsView lyrics_view {
                        height-request: 280;
                        width-request: 280;
                      };
                    }
                  }

                  Box {
                    orientation: vertical;
                    spacing: 2;
                    width-request: 256;

                    Box {
                      halign: center;

                      $AubadeWaveformView waveform_view {
                        can-focus: "true";
                      }
                    }

                    CenterBox {
                      orientation: horizontal;
                      width-request: 256;
                      halign: center;

                      [start]
                      Label elapsed_label {
                        label: "0:00";

                        accessibility {
                          label: C_("a11y", "Elapsed time");
                        }

                        styles [
                          "caption",
                          "numeric",
                        ]
                      }

                      [end]
                      Label remaining_label {
                        label: "0:00";

                        accessibility {
                          label: C_("a11y", "Remaining time");
                        }

                        styles [
                          "caption",
                          "numeric",
                        ]
                      }
                    }
                  }

                  $AubadeSongDetails song_details {}

                  $AubadePlaybackControl playback_control {
                    halign: "center";
                    margin-top: "0";
                    margin-bottom: "24";
                  }
                  };
                };

                sidebar: $AubadePlaylistView playlist_view {};
              }
            };
          }

          StackPage {
            name: "fullscreen";

            child: $AubadeFullScreenView fullscreen_view {};
          }

          StackPage {
            name: "home";

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                show-title: false;

                [start]
                Button {
                  icon-name: "go-previous-symbolic";
                  tooltip-text: _("Back to the Queue");
                  action-name: "win.leave-home";
                  valign: center;
                }
              }

              content: ScrolledWindow {
                hscrollbar-policy: never;
                vexpand: true;

                child: $AubadeOctaveHome octave_home {};
              };
            };
          }

        };
      };
    }
  };

  Adw.Breakpoint {
    condition ("max-width: 560sp")

    setters {
      split_view.collapsed: true;
    }
  }
}
