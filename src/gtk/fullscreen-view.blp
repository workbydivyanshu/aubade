using Gtk 4.0;

template $AubadeFullScreenView: Widget {
  Overlay {
    $AubadeBlurredBackdrop backdrop {
      hexpand: true;
      vexpand: true;
    }

    [overlay]
    Box scrim {
      hexpand: true;
      vexpand: true;

      styles [
        "fullscreen-scrim",
      ]
    }

    [overlay]
    Box content {
      orientation: vertical;
      spacing: 12;
      margin-start: 42;
      margin-end: 42;
      margin-top: 24;
      margin-bottom: 30;
      hexpand: true;
      vexpand: true;

      CenterBox header {
        margin-bottom: 10;

        [start]
        Button {
          icon-name: "go-previous-symbolic";
          tooltip-text: _("Leave Full Screen");
          action-name: "win.leave-fullscreen";

          styles [
            "octave-icon-button",
          ]
        }

        [center]
        Box {
          orientation: vertical;
          spacing: 3;
          halign: center;

          Label {
            label: _("NOW PLAYING");
            halign: center;

            styles [
              "octave-eyebrow",
            ]
          }

          Label header_title_label {
            ellipsize: end;
            max-width-chars: 36;
            halign: center;

            styles [
              "octave-body",
            ]
          }
        }

        [end]
        Button {
          icon-name: "open-menu-symbolic";
          tooltip-text: _("More Options");

          styles [
            "octave-icon-button",
          ]
        }
      }

      Box main_content {
        orientation: horizontal;
        spacing: 42;
        hexpand: true;
        vexpand: true;

        Box left_column {
          orientation: vertical;
          spacing: 18;
          width-request: 430;
          halign: center;
          valign: center;
          hexpand: true;
          vexpand: true;

          Image cover_thumb {
            width-request: 360;
            height-request: 360;
            halign: center;
            valign: center;
            overflow: hidden;

            styles [
              "octave-album-cover",
            ]
          }

          Box track_details {
            orientation: vertical;
            spacing: 5;
            halign: fill;
            hexpand: true;

            Label title_label {
              xalign: 0;
              ellipsize: end;

              styles [
                "octave-hero-title",
              ]
            }

            Label artist_label {
              xalign: 0;
              ellipsize: end;

              styles [
                "octave-muted",
              ]
            }
          }

          Box scrubber_row {
            orientation: vertical;
            spacing: 4;
            hexpand: true;

            Scale scrubber {
              draw-value: false;
              hexpand: true;

              styles [
                "fullscreen-scrubber",
              ]
            }

            Box {
              spacing: 12;
              hexpand: true;

              Label elapsed_label {
                label: "0:00";
                xalign: 0;
                hexpand: true;

                styles [
                  "octave-meta",
                ]
              }

              Label remaining_label {
                label: "−0:00";
                xalign: 1;

                styles [
                  "octave-meta",
                ]
              }
            }
          }

          Box transport {
            spacing: 14;
            halign: center;
            margin-top: 4;

            ToggleButton {
              icon-name: "media-playlist-shuffle-symbolic";
              action-name: "queue.shuffle";
              tooltip-text: _("Shuffle");

              styles [
                "octave-icon-button",
              ]
            }

            Button {
              icon-name: "media-skip-backward-symbolic";
              tooltip-text: _("Previous");
              action-name: "win.previous";

              styles [
                "octave-icon-button",
              ]
            }

            Button fullscreen_play_button {
              icon-name: "media-playback-start-symbolic";
              tooltip-text: _("Play");
              action-name: "win.play";

              styles [
                "fullscreen-play-button",
              ]
            }

            Button {
              icon-name: "media-skip-forward-symbolic";
              tooltip-text: _("Next");
              action-name: "win.next";

              styles [
                "octave-icon-button",
              ]
            }

            Button {
              icon-name: "media-playlist-consecutive-symbolic";
              tooltip-text: _("Repeat");
              action-name: "queue.repeat-mode";

              styles [
                "octave-icon-button",
              ]
            }
          }
        }

        Box lyrics_column {
          hexpand: true;
          vexpand: true;
          valign: fill;

          $AubadeLyricsView lyrics_view {
            hexpand: true;
            vexpand: true;

            styles [
              "fullscreen",
            ]
          }
        }
      }
    }
  }
}
